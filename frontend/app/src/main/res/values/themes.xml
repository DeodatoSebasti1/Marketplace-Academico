<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- O seu tema principal da aplicação, sem alterações -->
    <style name="Theme.Frontend" parent="android:Theme.Material.Light.NoActionBar" />


    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Cor de fundo da tela -->
        <item name="windowSplashScreenBackground">@color/vermelho</item>

        <!-- Ícone que aparece no centro (o mesmo ícone da app) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Tema para onde a aplicação transita após a splash -->
        <item name="postSplashScreenTheme">@style/Theme.Frontend</item>
    </style>

</resources>
