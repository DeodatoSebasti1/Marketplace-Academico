<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1. Este é o tema principal do seu aplicativo -->
    <style name="Theme.Frontend" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 2. Este é o NOVO tema, apenas para a Splash Screen de inicialização -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Cor de fundo da splash screen -->
        <item name="windowSplashScreenBackground">#FFFFFF</item> <!-- Mude para a cor que preferir -->

        <!-- Ícone que aparecerá no centro (use o seu ícone de launcher) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Tema que será aplicado DEPOIS que a splash screen sumir -->
        <item name="postSplashScreenTheme">@style/Theme.Frontend</item>
    </style>
</resources>
