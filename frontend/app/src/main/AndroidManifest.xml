<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--permissao para acesser imagens no android 13+-->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Frontend"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">


        <!-- Activity de Login: É a porta de entrada da aplicação -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting">  <!-- APLIQUE O TEMA AQUI -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Activity de Cadastro de Utilizador -->
        <activity
            android:name=".ui.cadastro.CadastroActivity"
            android:exported="false"
            android:label="Criar Conta"
            android:theme="@style/Theme.Frontend" />

        <!-- Tela Principal da Aplicação -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:label="Home"
            android:theme="@style/Theme.Frontend" />

        <!-- Telas de Perfil -->
        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:exported="false"
            android:label="Meu Perfil"
            android:theme="@style/Theme.Frontend" />
        <activity
            android:name=".ui.perfil.EditarPerfilActivity"
            android:exported="false"
            android:label="Editar Perfil"
            android:theme="@style/Theme.Frontend" />

        <!-- Telas relacionadas a Produtos -->
        <activity
            android:name=".ui.produto.DetalheProdutoActivity"
            android:exported="false"
            android:label="Detalhes do Produto"
            android:theme="@style/Theme.Frontend" />
        <activity
            android:name=".ui.produto.PostarProdutoActivity"
            android:exported="false"
            android:label="Anunciar Produto"
            android:theme="@style/Theme.Frontend" />
        <activity
            android:name=".ui.produto.FavoritosActivity"
            android:exported="false"
            android:label="Meus Favoritos"
            android:theme="@style/Theme.Frontend" />

        <!-- Telas de Mensagens de Propostas -->
        <activity
            android:name=".ui.mensagens.ListaPropostasActivity"
            android:exported="false"
            android:label="Mensagens de Propostas"
            android:theme="@style/Theme.Frontend" />
        <activity
            android:name=".ui.mensagens.DetalhePropostaActivity"
            android:exported="false"
            android:label="Detalhe da Proposta"
            android:theme="@style/Theme.Frontend" />
        <activity
            android:name=".ui.recuperacao.RecuperarSenhaActivity"
            android:exported="false"
            android:label="Detalhe da Proposta"
            android:theme="@style/Theme.Frontend" />

    </application>

</manifest>
